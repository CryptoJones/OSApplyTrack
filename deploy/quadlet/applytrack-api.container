[Unit]
Description=OSApplyTrack API (.NET, serves the SPA)
Requires=applytrack-db.service
After=applytrack-db.service

[Container]
ContainerName=applytrack-api
Image=ghcr.io/cryptojones/osapplytrack-api:latest
Network=applytrack.network
EnvironmentFile=%h/.config/applytrack/applytrack.env
Volume=applytrack-secrets.volume:/var/lib/applytrack
Environment=ASPNETCORE_URLS=http://+:8080
# Loopback only (#345): Kestrel speaks plain HTTP, so on the LAN the session cookie
# would travel without Secure. Put a TLS reverse proxy on this host in front of it
# (see README · Deploying behind a reverse proxy). Relocating? Change the HOST port
# only (the container side stays 8080) and keep the ExecStartPre port below in sync.
PublishPort=127.0.0.1:8080:8080
# The hardening docker-compose.production.yml has had since #53 (#345): the image's
# non-root uid, a read-only root with a noexec /tmp, no capabilities, no setuid gain.
# The secrets volume stays writable — it is a mount, not the root filesystem.
User=1654:1654
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=64m
DropCapability=ALL
NoNewPrivileges=true
RunInit=true

[Service]
# Guard rail: refuse to start when something else already listens on the host
# port, instead of silently winning the bind race (8080 is contested — vLLM,
# llama.cpp, and half of all dev tools default to it). A clear journal error
# beats a mystery conflict. Keep the port here in sync with PublishPort.
ExecStartPre=/bin/sh -c 'if ss -tlnH "sport = :8080" | grep -q .; then echo "applytrack-api: host port 8080 is already in use — refusing to bind over it (edit PublishPort + this check)"; exit 1; fi'
Restart=always

[Install]
WantedBy=default.target
