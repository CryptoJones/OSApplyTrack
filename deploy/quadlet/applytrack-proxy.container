[Unit]
Description=OSApplyTrack egress proxy (the browser's only way out)

[Container]
ContainerName=applytrack-proxy
Image=ghcr.io/cryptojones/osapplytrack-proxy:latest
Network=applytrack-browser.network
Network=applytrack.network
DropCapability=ALL
# squid starts as root only to drop to its own user; that needs exactly these.
AddCapability=SETUID SETGID CHOWN
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
