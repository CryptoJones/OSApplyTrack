# The generated encryption key, when APPLYTRACK_SECRETS_KEY is not in the env file.
# Shared by the api and agent containers (both decrypt the same rows) and, read-only,
# the poller (it opens the board sessions). Back it up with the database: losing it
# loses the résumé, letters, packets and screenshots.
[Volume]
VolumeName=applytrack-secrets
