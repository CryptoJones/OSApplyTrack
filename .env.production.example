# Production deployments intentionally have no working secret defaults.
# Copy this file to .env.production, replace every CHANGE-ME value, keep the
# result out of version control, and pin a released OSApplyTrack version.
OSAPPLYTRACK_VERSION=1.54.5
POSTGRES_USER=applytrack
POSTGRES_PASSWORD=CHANGE-ME-use-a-long-random-password
POSTGRES_DB=applytrack

# The agent worker's and the poller's own least-privilege Postgres roles (no
# DELETE on applications, no access to sessions/magic_tokens, no DDL). The api
# creates them on boot and keeps their passwords in step; the agent and poller
# containers connect as them. Independent random values; do not reuse
# POSTGRES_PASSWORD. Changing one here and restarting re-passwords the role.
AGENT_DB_PASSWORD=CHANGE-ME-use-another-long-random-password
POLLER_DB_PASSWORD=CHANGE-ME-use-a-third-long-random-password

# Public HTTPS origin and hostname served by the TLS reverse proxy.
APP_PUBLIC_BASE_URL=https://apply.example.com
ALLOWED_HOSTS=apply.example.com
API_PORT=8080

# Required. Encrypts at rest (AES-256-GCM) the résumé PDF, cover letters, packet
# answers and posting text, evidence screenshots, and each tenant's own LLM API key
# and Telegram bot token. Generate an independent random value (openssl rand
# -base64 48); do not reuse POSTGRES_PASSWORD. BACK IT UP with the database: losing
# it loses everything it encrypts. Rotate by setting the new value here and the old
# one in APPLYTRACK_SECRETS_KEY_PREVIOUS, restarting, then removing the old one.
APPLYTRACK_SECRETS_KEY=CHANGE-ME-use-an-independent-long-random-key
# APPLYTRACK_SECRETS_KEY_PREVIOUS=

# Trust the reverse proxy's forwarded protocol/client IP. REQUIRED whenever the proxy
# reaches the container from a non-loopback address — which includes this stack's default
# (a host reverse proxy forwarding to the published 127.0.0.1 port arrives as the Docker
# bridge gateway, e.g. 172.17.0.1, NOT loopback). Leave it unset and the app never sees
# HTTPS: the session cookie loses its Secure flag and app-level HSTS is not emitted (the
# api logs a one-time warning naming the exact peer address to put here). Set the proxy's
# address, or its subnet, to the value the warning reports. Never trust 0.0.0.0/0 or ::/0.
# FORWARDED_HEADERS_KNOWN_PROXY=172.17.0.1
# FORWARDED_HEADERS_KNOWN_NETWORK=172.18.0.0/16

# Optional SMTP and LLM settings use the same variables as .env.example.
# Email__Host=smtp.example.com
# Email__Port=587
# Email__Username=apply
# Email__Password=CHANGE-ME
# Email__From=apply@example.com
# Llm__BaseUrl=https://llm.example.com/v1
# Llm__Model=your-model
# Llm__ApiKey=CHANGE-ME
# Llm__DailyCapPerTenant=200   # model requests per tenant per UTC day on Llm__ApiKey (0 = unlimited)

# The agent: passes every AGENT_INTERVAL seconds (per tenant it is still off until
# enabled in Settings · Agent). The browser + proxy containers are on by default
# in this stack; the agent reaches them at ws://browser:3000/ and http://proxy:3128.
# AGENT_INTERVAL=300
