<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApplyTrack.Api</RootNamespace>
    <Version>1.68.5</Version>
    <Authors>Aaron K. Clark</Authors>
    <Copyright>Copyright 2026 Aaron K. Clark</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.19.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <!-- Transitive floor (#459): MailKit → MimeKit pulls System.Security.Cryptography.Pkcs
         10.0.0, flagged by GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate).
         A direct reference lifts the resolved version above the patched 10.0.13. Drop
         this once MailKit/MimeKit raise their own floor. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Migrations are run by DbUp from embedded resources, so they ship inside
       the assembly and the same runner works locally and in a container. -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
    <!-- Run-always scripts (the agent role's grants), applied after the versioned ones. -->
    <EmbeddedResource Include="Migrations\Always\*.sql" />
    <!-- The Public Suffix List (MPL-2.0), for registrable domains (#343). -->
    <EmbeddedResource Include="Domains\public_suffix_list.dat" LogicalName="ApplyTrack.Api.Domains.public_suffix_list.dat" />
  </ItemGroup>

</Project>
